APP_NAME="OurSoft Pay"
APP_ENV=production
# OBRIGATÓRIA e ESTÁVEL: criptografa as credenciais bancárias no banco. Trocar = perder as credenciais.
APP_KEY=
APP_DEBUG=false
APP_URL=https://pay.oursoft.com.br
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oursoft_pay
DB_USERNAME=oursoft_pay
DB_PASSWORD=

# Lidas pelo container MySQL (mesmos valores de DB_*).
MYSQL_DATABASE=oursoft_pay
MYSQL_USER=oursoft_pay
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

PAY_HTTP_TIMEOUT=30
PAY_PIX_DEFAULT_EXPIRATION=86400
PAY_RATE_LIMIT=600
