# Imagem de produção: nginx + php-fpm no mesmo container.
# A mesma imagem roda a fila e o agendador trocando o comando (ver docker-compose.prod.yml).
FROM php:8.4-fpm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y nginx unzip libzip-dev libicu-dev --no-install-recommends \
    && docker-php-ext-install pdo_mysql zip bcmath intl pcntl opcache \
    && rm -rf /var/lib/apt/lists/*

RUN cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini \
    && printf '%s\n' \
        'expose_php = Off' \
        'opcache.memory_consumption = 128' \
        'opcache.interned_strings_buffer = 16' \
        'opcache.max_accelerated_files = 20000' \
        'opcache.validate_timestamps = 0' \
        > /usr/local/etc/php/conf.d/zz-app.ini \
    && sed -i 's#listen = \[::\]:9000#listen = 127.0.0.1:9000#' /usr/local/etc/php-fpm.d/www.conf \
    && echo 'clear_env = no' >> /usr/local/etc/php-fpm.d/www.conf

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-interaction --prefer-dist --no-dev --no-scripts --no-autoloader \
    && composer clear-cache

COPY --chown=www-data:www-data . .
RUN composer dump-autoload --optimize --no-dev \
    && php artisan package:discover \
    && mkdir -p storage/logs storage/framework/cache storage/framework/views storage/app/private bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/prod-entrypoint.sh /usr/local/bin/prod-entrypoint.sh
RUN chmod +x /usr/local/bin/prod-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/prod-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
